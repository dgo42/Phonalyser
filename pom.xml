<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phonalyser - multi-module AGGREGATOR.

  This POM answers one question only: what gets built, and in what order.  All
  version and configuration policy lives in phonalyser-parent, which every module
  (and this aggregator) names as its <parent>.  Splitting the two is the
  spring-boot-parent shape: the module list can change without touching version
  policy, and any module can be built on its own without the aggregator.

  Layering:

      phonalyser-parent                  versions, plugins, OS profiles
      server-api                         net wire format; JSON only, no core
      phonalyser-core                    base; no Phonalyser dependencies, no SWT
        ├── backend-wdm-ks               PortAudio host-API backends; the other
        │                                three share its PortAudio layer
        ├── backend-wasapi
        ├── backend-coreaudio
        ├── backend-javasound
        ├── backend-qa40x                + its own contract (Qa40xControl,
        │                                Qa40xDeviceInfo) - core stays vendor-free
        ├── backend-loopback             (placeholder - in-app digital loopback)
        ├── server-net                   headless net server (+ server-api and
        │                                EVERY backend above: this is the machine
        │                                the hardware is wired to).  Never
        │                                backend-net - that half is the client
        ├── backend-net                  net client (+ server-api).  The server
        │                                appears in NO scope, tests included: its
        │                                tests mock the far end of the socket
        └── phonalyser-cli
             └── phonalyser-gui-core     shared SWT infrastructure
                  ├── phonalyser-gui     the application (+ server-net, which the
                  │                      server switch starts in-process)
                  ├── backend-qa40x-gui  a backend's own UI (+ backend-qa40x)
                  └── backend-net-gui    the net backend's UI (+ backend-net)
                       └── phonalyser-app  fat jar + jpackage installer

  Backends and backend settings panels are discovered at runtime through
  ServiceLoader, so no CODE names a concrete backend and none of the arrows
  above ever points back up.  The dependencies exist only to put the providers
  on the class path of whoever must offer them: the CLI, the packaged app, and
  the server that serves them.

  Every module lives under modules/; this POM is the only place that spells that
  out, since each module names its parent as the sibling ../phonalyser-parent.

  Packaging cannot live here: a Maven reactor builds the aggregator BEFORE its
  modules, so phonalyser-app is declared last and consumes every other module's
  artifact.  The packaging ASSETS stay at this level (src/main/assembly,
  src/main/jpackage, src/main/packaging, src/pdf-tool) and phonalyser-app reaches
  them via ${project.basedir}/../.. - nothing had to move.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.edgo.phonalyser</groupId>
        <artifactId>phonalyser-parent</artifactId>
        <version>1.2.1</version>
        <relativePath>modules/phonalyser-parent</relativePath>
    </parent>

    <artifactId>phonalyser-build</artifactId>
    <packaging>pom</packaging>

    <name>Phonalyser (build)</name>
    <description>Precision audio measurement workbench: signal generator, oscilloscope, FFT and ADC calibration</description>

    <properties>
        <!-- The inherited value is relative to a module directory; this POM's
             basedir IS the build root, so it drops the "..".  Modules are NOT
             affected: their parent is phonalyser-parent, not this aggregator. -->
        <checkstyle.config>${project.basedir}/config/checkstyle/checkstyle.xml</checkstyle.config>
    </properties>

    <!-- One module: the modules/ aggregator, which names the eighteen.  Keeping
         the list there rather than here means the directory is a Maven project in
         its own right, so an IDE opened on it (or indexing folder by folder, as
         VS Code's Java support does) discovers them all. -->
    <modules>
        <module>modules</module>
    </modules>
</project>
