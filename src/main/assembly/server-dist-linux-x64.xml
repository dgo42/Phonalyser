<?xml version="1.0" encoding="UTF-8"?>
<!-- Headless-server distribution zip, Linux x86_64.

     NO natives/ folder, and that is the design, not an omission: ALSA reaches
     the JavaSound backend through javax.sound.sampled inside the JDK, and the
     QA40x backend uses the distribution's own libusb - which is why the desktop
     .deb declares libusb as a package dependency instead of shipping one
     (PACKAGING.md §2).  The launcher notices the missing folder and adds no
     library-path properties at all.

     The QA40x udev rule is the SAME file the .deb installs
     (src/main/jpackage/linux/70-qa40x.rules), shipped rather than copied into a
     second source: the service script installs it from here.

     The two Linux zips (x86_64 and aarch64) differ in name only - a Raspberry
     Pi runs the same bytes. -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>linux-x64</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>

    <files>
        <file>
            <source>${project.build.directory}/${server.mainJar}</source>
            <outputDirectory>/</outputDirectory>
            <fileMode>0644</fileMode>
        </file>
        <file>
            <source>${repo.root}/src/main/jpackage/linux/70-qa40x.rules</source>
            <outputDirectory>/</outputDirectory>
            <fileMode>0644</fileMode>
        </file>
    </files>

    <fileSets>
        <!-- Executable in the zip, so an operator who unpacks it can run the
             launcher without a chmod first. -->
        <fileSet>
            <directory>${repo.root}/src/main/packaging/unix</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>phonalyser-server.sh</include>
                <include>phonalyser-server-service.sh</include>
            </includes>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
        </fileSet>
        <fileSet>
            <directory>${repo.root}/src/main/packaging/unix</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>README-server-linux.txt</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <!-- The web bundle this server serves at `/` (spec 3): a `web` directory
             BESIDE THE JAR, which is exactly where ServerMain.staticDir() looks -
             the jar's own CodeSource parent resolved against "web", else the same
             name in the working directory.  It is a FILESYSTEM path and never a
             classpath resource, so it belongs in the dist and not inside the jar.

             A fileSet because this one IS optional: the bundle is produced by the
             embedded web build (`node web/build.mjs` with the embedded flag, which
             make-servers.cmd runs after the clean and before the package, and which
             no Maven goal drives), and a build made without that step
             simply ships no web/ - the server then answers today's "no web bundle
             is served by this server" 404, which spec 3 marks "when built with it". -->
        <fileSet>
            <directory>${repo.root}/target/web-embedded</directory>
            <outputDirectory>/web</outputDirectory>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>
</assembly>
