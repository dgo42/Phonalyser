<?xml version="1.0" encoding="UTF-8"?>
<!-- Headless server JAR: the standard jar-with-dependencies layout and nothing
     else.

     Deliberately NOT src/main/assembly/fat-jar.xml.  That descriptor adds two
     fileSets that read help/** and i18n/** out of ../phonalyser-gui(-core) by a
     path RELATIVE to the consuming module - from modules/server-net they would
     resolve just as happily and pack ~14 MB of desktop help and locale bundles
     into a jar that has no window to show them in.  The server needs neither, so
     it gets a descriptor with no fileSets at all.

     META-INF/services is merged across every unpacked jar.  This is load-bearing
     here: five backend modules (javasound, wasapi, wdm-ks, coreaudio, qa40x)
     each ship their own
     META-INF/services/org.edgo.audio.measure.sound.AudioDeviceManagerProvider,
     and without the handler the last one unpacked would silently overwrite the
     rest - a server that then serves exactly one backend. -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>server-jar</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <containerDescriptorHandlers>
        <containerDescriptorHandler>
            <handlerName>metaInf-services</handlerName>
        </containerDescriptorHandler>
    </containerDescriptorHandlers>
    <dependencySets>
        <!-- Mirrors the built-in jar-with-dependencies descriptor: this module's
             own classes plus core, the wire format, every local backend and the
             third-party jars they need. -->
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <unpack>true</unpack>
            <scope>runtime</scope>
            <unpackOptions>
                <excludes>
                    <!-- The OTHER architecture's resource folder, anchored at the
                         archive ROOT so this covers only the app's own natives
                         (PortAudio, libusb, csjsound).  The folder for THIS
                         build's arch stays COMPLETE - that is what makes a bare
                         `java -jar` open devices with nothing on
                         java.library.path.  Set per platform profile in
                         phonalyser-parent; on Linux and macOS it drops both
                         win32 arches, since no win32 resource can load there. -->
                    <exclude>${platform.nativeExcludes}</exclude>
                    <!-- jna.jar's OWN natives: it ships jnidispatch for ~26
                         platforms, 4.9 MB of which exactly one folder is
                         loadable here.  Dropping them BY FILE NAME is what makes
                         this safe - com/sun/jna/win32/ is a Java PACKAGE
                         (StdCallLibrary, W32APIOptions) sitting right beside the
                         win32-x86-64/ platform folder, so any win32* glob would
                         delete code the build compiles against.  These four
                         patterns match only the native itself, in any platform
                         folder; the one this build needs is put back by the
                         second dependencySet below. -->
                    <exclude>com/sun/jna/*/jnidispatch.dll</exclude>
                    <exclude>com/sun/jna/*/libjnidispatch.so</exclude>
                    <exclude>com/sun/jna/*/libjnidispatch.jnilib</exclude>
                    <exclude>com/sun/jna/*/libjnidispatch.a</exclude>
                </excludes>
            </unpackOptions>
        </dependencySet>
        <!-- ...and jnidispatch for THIS platform only, put back after the sweep
             above removed every arch.  Restricted to the one folder, so nothing
             else in jna.jar is unpacked twice and the services handler sees
             nothing from here. -->
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <unpack>true</unpack>
            <scope>runtime</scope>
            <includes>
                <include>net.java.dev.jna:jna</include>
            </includes>
            <unpackOptions>
                <includes>
                    <include>com/sun/jna/${jna.resourcePrefix}/**</include>
                </includes>
            </unpackOptions>
        </dependencySet>
    </dependencySets>
    <fileSets>
        <!-- macOS is the one platform whose natives are not already module
             resources: they live in the repo's lib/macos-*.  Mapped to JNA's
             Platform.RESOURCE_PREFIX folder so Native.load extracts them exactly
             as it does the win32 copies - without this a bare `java -jar` on
             macOS has no PortAudio at all, and therefore no CoreAudio devices.
             Off every other platform macos.nativeSrc points at lib/ itself,
             which holds no *.dylib directly, so this contributes nothing. -->
        <fileSet>
            <directory>${macos.nativeSrc}</directory>
            <outputDirectory>/${jna.resourcePrefix}</outputDirectory>
            <includes>
                <include>*.dylib</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
