<?xml version="1.0" encoding="UTF-8"?>
<!-- Headless server JAR: the standard jar-with-dependencies layout and nothing
     else - and ONE file for every platform and architecture, the natives it
     carries covering all of them (see the dependencySet below).  What makes a
     bundle a Windows or a macOS bundle is the dist zip around this jar, never
     the jar.

     Deliberately NOT src/main/assembly/fat-jar.xml.  That descriptor adds two
     fileSets that read help/** and i18n/** out of ../phonalyser-gui(-core) by a
     path RELATIVE to the consuming module - from modules/server-net they would
     resolve just as happily and pack ~14 MB of desktop help and locale bundles
     into a jar that has no window to show them in.  The server needs neither, so
     it gets a descriptor with no fileSets at all.

     META-INF/services is merged across every unpacked jar.  This is load-bearing
     here: five backend modules (javasound, wasapi, wdm-ks, coreaudio, qa40x)
     each ship their own
     META-INF/services/org.edgo.audio.measure.sound.AudioDeviceManagerProvider,
     and without the handler the last one unpacked would silently overwrite the
     rest - a server that then serves exactly one backend. -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>server-jar</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <containerDescriptorHandlers>
        <containerDescriptorHandler>
            <handlerName>metaInf-services</handlerName>
        </containerDescriptorHandler>
    </containerDescriptorHandlers>
    <dependencySets>
        <!-- Mirrors the built-in jar-with-dependencies descriptor: this module's
             own classes plus core, the wire format, every local backend and the
             third-party jars they need.

             NOTHING here is narrowed to an architecture: this is ONE jar for
             every platform.  It keeps the app's own natives (PortAudio, libusb,
             csjsound) for all arches under their JNA Platform.RESOURCE_PREFIX
             folders, and jna.jar's own jnidispatch for all ~26 platforms it
             ships, so Native.load extracts whichever set matches the JVM that
             happens to run the jar - a bare `java -jar` opens devices on any of
             them, with nothing on java.library.path.  The foreign arches cost
             about five megabytes of jnidispatch plus the other platforms' device
             libraries; being able to hand out one server jar is worth it.

             The per-platform dist zips still stage their own natives beside the
             jar, which is what the launcher's library paths point at.  The
             DESKTOP fat jar still narrows to one arch: it also carries SWT and
             LWJGL, which are single-arch by construction. -->
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <unpack>true</unpack>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>
    <fileSets>
        <!-- macOS is the one platform whose natives are not already module
             resources: they live in the repo's lib/macos-*.  BOTH arches are
             mapped to their JNA Platform.RESOURCE_PREFIX folder, so Native.load
             extracts them exactly as it does the win32 copies whichever Mac the
             jar lands on - and both are copied whatever host builds, the jar
             being the same file everywhere.  Without them a bare `java -jar` on
             macOS has no PortAudio at all, and therefore no CoreAudio devices. -->
        <fileSet>
            <directory>${repo.root}/lib/macos-x64</directory>
            <outputDirectory>/darwin-x86-64</outputDirectory>
            <includes>
                <include>*.dylib</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${repo.root}/lib/macos-arm64</directory>
            <outputDirectory>/darwin-aarch64</outputDirectory>
            <includes>
                <include>*.dylib</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
