<?xml version="1.0" encoding="UTF-8"?>
<!--
  The modules/ aggregator.

  It exists so that this directory is itself a Maven project: an IDE that is
  opened on modules/ (or that indexes folder by folder, as VS Code's Java
  support does) finds a POM here and picks up all fourteen modules, instead of
  seeing fourteen unrelated folders whose parent is nowhere in the tree.

  The build root above declares this one module and nothing else, so the module
  list lives in exactly one place — here, beside the modules it names.

  Version and plugin policy is NOT set here: like every module, this POM's
  parent is phonalyser-parent, which happens to be one of its own children.
  That is legal and is the reason phonalyser-parent is listed first below.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.edgo.phonalyser</groupId>
        <artifactId>phonalyser-parent</artifactId>
        <version>1.1.1</version>
        <relativePath>phonalyser-parent</relativePath>
    </parent>

    <artifactId>phonalyser-modules</artifactId>
    <packaging>pom</packaging>

    <name>Phonalyser (modules)</name>

    <properties>
        <!-- The inherited value is relative to a MODULE directory (modules/<name>);
             this POM sits one level higher, so it drops one "..". -->
        <checkstyle.config>${project.basedir}/../config/checkstyle/checkstyle.xml</checkstyle.config>
    </properties>

    <!-- Maven reorders by the dependency graph anyway; the declared order
         documents the intended layering and keeps a failure easy to read. -->
    <modules>
        <module>phonalyser-parent</module>
        <!-- Vendored third party (Project Nayuki's FLAC library, LGPLv3), built as
             part of the reactor so nobody has to install it by hand first.  It
             keeps its own standalone POM — no phonalyser-parent, so our checkstyle
             and plugin policy do not apply to source we do not own. -->
        <module>flac-library-java</module>
        <module>phonalyser-core</module>
        <module>backend-wdm-ks</module>
        <module>backend-wasapi</module>
        <module>backend-coreaudio</module>
        <module>backend-javasound</module>
        <module>backend-qa40x</module>
        <module>backend-loopback</module>
        <module>backend-net</module>
        <module>phonalyser-cli</module>
        <module>phonalyser-gui-core</module>
        <module>phonalyser-gui</module>
        <module>backend-qa40x-gui</module>
        <module>phonalyser-app</module>
    </modules>
</project>
