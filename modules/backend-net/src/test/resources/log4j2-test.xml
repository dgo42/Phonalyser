<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-scope log config: Maven/Surefire picks this up automatically during
     `mvn test`.  This module inherits NO main log4j2.xml (the desktop config
     lives in phonalyser-gui, the server's in server-net), so without this file
     log4j would fall back to its built-in default and print unconfigured
     status noise; with it, the test output is the one shape every module's
     test run has. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%-5level] %msg%n"/>
        </Console>
        <!-- app.log.dir is set by Surefire (phonalyser-parent) to this module's
             own target/test-logs, as an ABSOLUTE path: the literal default below
             would resolve against the runner's working directory, which is the
             repo root under an IDE run - and there `logs/` is a junction into
             the live app log.  Under target/ either way, so it is gitignored and
             wiped by `mvn clean`. -->
        <File name="File"
              fileName="${sys:app.log.dir:-target/test-logs}/phonalyser-test.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] %logger{36} - %msg%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
