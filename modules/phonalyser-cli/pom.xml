<?xml version="1.0" encoding="UTF-8"?>
<!--
  phonalyser-cli - the headless command-line modes (org.edgo.audio.measure.Main
  plus cli.**).  Verified SWT-free and gui-free: nothing here imports
  org.eclipse.swt or org.edgo.audio.measure.gui.

  It compiles against phonalyser-core only.  The concrete backends are a RUNTIME
  concern (they are resolved through AudioBackend), so they are declared with
  runtime scope: the CLI must not name a backend class, but a CLI distribution
  needs them present to open a device.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.edgo.phonalyser</groupId>
        <artifactId>phonalyser-parent</artifactId>
        <version>1.2.1</version>
        <relativePath>../phonalyser-parent</relativePath>
    </parent>

    <artifactId>phonalyser-cli</artifactId>
    <name>Phonalyser :: CLI</name>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>phonalyser-core</artifactId>
        </dependency>
        <!-- FreqRespMode renders its sweep to PNG. -->
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
        </dependency>

        <!-- Backends are RUNTIME only: they are discovered through the service
             loader, so CLI code never names one - with the single exception of
             JavaSound below. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>backend-wdm-ks</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>backend-wasapi</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>backend-coreaudio</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- COMPILE scope, unlike its siblings: CliAppPaths names the JavaSound
             backend's native-path helper to stage the csjsound provider's DLL for
             fat-jar runs, which has to happen before the JavaSound service scan.
             Do NOT also list it in runtime scope - a second declaration of the same
             artifact wins with its own scope and silently demotes this one, and the
             module then fails to compile. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>backend-javasound</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>backend-qa40x</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
