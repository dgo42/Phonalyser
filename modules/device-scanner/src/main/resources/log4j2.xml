<?xml version="1.0" encoding="UTF-8"?>
<!-- The backend modules log through log4j2; their WARN/ERROR lines are part
     of the diagnostic picture, so they go to the console beside the report
     lines (the report file itself stays clean scan output). -->
<Configuration status="warn">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%level] %logger{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
