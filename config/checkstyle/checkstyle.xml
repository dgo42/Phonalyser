<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Checkstyle rules for the multi-module build.

  Deliberately MINIMAL: only structural checks that the compiler cannot make and
  that produce zero noise on the existing tree.  This is not a style ruleset -
  house style is documented in CLAUDE.md and enforced by the repo hooks.  Add
  rules here consciously, one at a time, so the build never starts failing for
  reasons nobody chose.

  Why this file exists at all: during the module split, two files were moved into
  a new directory while keeping their old `package` declaration.  They compiled
  cleanly - javac does NOT check package against directory for source files
  passed explicitly on the command line, which is exactly how Maven invokes it -
  and the classes silently landed in the OLD package, contributed from a second
  jar.  The only symptom was a baffling
  "Qa40xDeviceInfo cannot be converted to Qa40xDeviceInfo".
  PackageDeclaration turns that into a named file and line number at `validate`.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <!-- Checkstyle defaults to the platform charset; the whole build is UTF-8. -->
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- The package declaration must match the file's directory.  The check
             that the module split needed; matchDirectoryStructure is the default
             but is stated explicitly so the intent survives a Checkstyle upgrade. -->
        <module name="PackageDeclaration">
            <property name="matchDirectoryStructure" value="true"/>
        </module>

        <!-- The file name must match the outer type it declares.  Same family of
             mistake as above - a renamed class in a stale file - and equally
             invisible to javac when sources are listed explicitly. -->
        <module name="OuterTypeFilename"/>
    </module>
</module>
